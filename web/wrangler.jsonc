{
  // Must match Workers & Pages project name: kaibau-lewka
  "name": "kaibau-lewka",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "build": {
    "command": "npm install && npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "lewka.kaibau.com", "custom_domain": true }
  ]
}
