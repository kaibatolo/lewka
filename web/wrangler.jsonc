{
  // Must match Workers & Pages project name (Settings → Builds).
  "name": "kaibau-lewka",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "lewka.kaibau.com", "custom_domain": true }
  ]
}
